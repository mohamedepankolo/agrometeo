# Copier en .env et adapter. Ne jamais committer .env.
# Sans aucune valeur, l'API démarre en mode développement (base SQLite locale, envois simulés).

ENV=dev                          # dev | test | prod  (prod refuse les envois simulés et les outils /dev)
DATABASE_URL=sqlite:///./anam_dev.db
# Production : postgresql+psycopg://utilisateur:motdepasse@hote:5432/anam

# OBLIGATOIRE en production (32+ caractères aléatoires) :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Clé de chiffrement des secrets 2FA (recommandé en prod, distincte de JWT_SECRET)
DATA_ENCRYPTION_KEY=

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
LOCAL_ACCOUNT_AUTO_ACTIVATE=false        # comptes locaux : activés seuls ou après validation d'un admin
REQUIRE_2FA_ROLES=administrateur,agent_anam

# Origines autorisées pour un navigateur (back-office web), séparées par des virgules
CORS_ORIGINS=

# --- Fichiers générés (PDF, images, audios, vidéos)
STORAGE_DIR=./storage
PUBLIC_BASE_URL=                          # ex. https://api.anam.bf : préfixe des URLs de médias (vide = relatives)
MAX_UPLOAD_MB=25

# --- Chaîne audio/vidéo (Module 1) : mêmes valeurs que module1/.env
MODULE1_DIR=../module1
CITADEL_TRANSLATE_URL=https://playground.citadel.bf/translation
CITADEL_API_EMAIL=
CITADEL_API_PASSWORD=
MOORE_API_BASE_URL=
MOORE_API_TOKEN=

# --- Canaux d'envoi. 'console' = simulation (rien ne part) ; interdit en production.
SMS_BACKEND=console                       # console | orange
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_SENDER=                            # ex. +22670000000
ORANGE_SENDER_NAME=ANAM

EMAIL_BACKEND=console                     # console | smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

PUSH_BACKEND=console                      # console | fcm
FCM_CREDENTIALS_FILE=                     # chemin du JSON de compte de service Firebase

WHATSAPP_BACKEND=console                  # console | cloud
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Traduction anglaise : auto (modèle local si installé, sinon MyMemory) | local | mymemory
TRANSLATION_BACKEND=auto
# LOCAL_TRANSLATION_MODEL=Helsinki-NLP/opus-mt-fr-en

# --- Repli MyMemory (gratuit) : une adresse e-mail à vous porte le plafond de ~5 000 à ~50 000 caractères/jour
MYMEMORY_EMAIL=
