# Copier ce fichier en .env et renseigner les valeurs (NE PAS committer .env).

# --- Traduction FR <-> mooré (plateforme playground CITADEL) ---
CITADEL_TRANSLATE_URL=https://playground.citadel.bf/translation
CITADEL_API_EMAIL=citadel.api.user@citadel.bf
CITADEL_API_PASSWORD=__mettre_le_mot_de_passe_ici__

# --- Service parole : TTS / ASR / S2ST (mooré) ---
MOORE_API_BASE_URL=https://__url_du_service_tts__
MOORE_API_TOKEN=__mettre_le_token_s2s_pat_ici__
