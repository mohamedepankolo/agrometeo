# Copier en .env et adapter. Ne jamais committer .env.

ENV=dev                          # dev | test | prod
DATABASE_URL=sqlite:///./auth_dev.db
# Production : postgresql+psycopg://utilisateur:motdepasse@hote:5432/anam_auth

# OBLIGATOIRE en production (32+ caractères aléatoires) :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Clé de chiffrement des secrets 2FA (recommandé en prod, distincte de JWT_SECRET)
DATA_ENCRYPTION_KEY=

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Comptes locaux (identifiant + mot de passe) : activés automatiquement ou après validation admin
LOCAL_ACCOUNT_AUTO_ACTIVATE=false
# Rôles dont la connexion exige la 2FA
REQUIRE_2FA_ROLES=administrateur,agent_anam

# Origines autorisées pour les appels depuis un navigateur (back-office web), séparées par des virgules
CORS_ORIGINS=

# Envoi des codes de vérification. 'console' = simple affichage dans les logs (interdit en prod).
SMS_BACKEND=console
EMAIL_BACKEND=console
# EMAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
